{
  "name": "favipulse",
  "version": "1.0.0",
  "description": "Tiny (<3 KB gz), zero-dependency, typed favicon library: deterministic generative/identicon favicons from a seed with self-drawing animation, badges, progress rings and pulse, plus per-environment (dev/staging/prod) icons. CLI generates svg/ico/png sets + manifest. Vite & Next.js helpers. Modern replacement for favico.js and tinycon.",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "unpkg": "./dist/favipulse.global.js",
  "jsdelivr": "./dist/favipulse.global.js",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./compat": {
      "import": {
        "types": "./dist/compat.d.ts",
        "default": "./dist/compat.mjs"
      },
      "require": {
        "types": "./dist/compat.d.cts",
        "default": "./dist/compat.cjs"
      }
    },
    "./node": {
      "import": {
        "types": "./dist/node.d.ts",
        "default": "./dist/node.mjs"
      },
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      }
    },
    "./vite": {
      "import": {
        "types": "./dist/vite.d.ts",
        "default": "./dist/vite.mjs"
      },
      "require": {
        "types": "./dist/vite.d.cts",
        "default": "./dist/vite.cjs"
      }
    },
    "./next": {
      "import": {
        "types": "./dist/next.d.ts",
        "default": "./dist/next.mjs"
      },
      "require": {
        "types": "./dist/next.d.cts",
        "default": "./dist/next.cjs"
      }
    },
    "./global": "./dist/favipulse.global.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "favipulse": "bin/favipulse.js"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepack": "npm run build",
    "test": "npm run build && node --test test/*.test.js",
    "demo": "node scripts/hero.mjs"
  },
  "keywords": [
    "favicon",
    "identicon",
    "badge",
    "progress",
    "notification",
    "generative",
    "environment",
    "favico",
    "tinycon",
    "vite-plugin",
    "nextjs",
    "svg",
    "pwa"
  ],
  "author": "Louis Wright <hello@louiswright.co.uk> (https://github.com/MrLouisWright)",
  "license": "MIT",
  "funding": {
    "type": "stripe",
    "url": "https://donate.stripe.com/aFa00lek3cvX4Ds2Fk9EI0b"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MrLouisWright/favipulse.git"
  },
  "bugs": {
    "url": "https://github.com/MrLouisWright/favipulse/issues"
  },
  "homepage": "https://mrlouiswright.github.io/favipulse/",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.25.10",
    "jsdom": "^24.1.3",
    "typescript": "^5.9.3"
  }
}
